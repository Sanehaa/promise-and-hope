generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model NavLink {
  id        String   @id @default(cuid())
  label     String
  href      String
  group     String   // main | footer_quick | footer_useful
  sortOrder Int      @default(0)
  published Boolean  @default(true)
}

model PageHero {
  id          String  @id @default(cuid())
  pageKey     String  @unique
  title       String?
  description String?
  imageUrl    String
  imageAlt    String  @default("")
}

model Service {
  id               String  @id @default(cuid())
  slug             String  @unique
  title            String
  shortDescription String
  description      String
  iconName         String
  imageUrl         String
  sortOrder        Int     @default(0)
  published        Boolean @default(true)
  showOnHome       Boolean @default(false)
  homeTitle        String?
  homeDescription  String?
  homeIconName     String?
}

model Project {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  location         String
  category         String
  shortDescription String
  description      String
  goals            String
  expectedImpact   String
  imageUrl         String
  targetAmount     Int
  raisedAmount     Int      @default(0)
  published        Boolean  @default(true)
  featured         Boolean  @default(false)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  donations        Donation[]
}

model CaseStory {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  location       String
  category       String
  excerpt        String
  content        String
  impactSummary  String
  imageUrl       String
  published      Boolean  @default(true)
  featured       Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
}

model RegionalOffice {
  id           String  @id @default(cuid())
  slug         String  @unique
  name         String
  region       String
  address      String
  phone        String
  email        String
  hours        String
  imageUrl     String
  mapUrl       String
  isHeadOffice Boolean @default(false)
  sortOrder    Int     @default(0)
  published    Boolean @default(true)
}

model GalleryItem {
  id        String  @id @default(cuid())
  title     String
  category  String
  imageUrl  String
  alt       String
  sortOrder Int     @default(0)
  published Boolean @default(true)
}

model Testimonial {
  id        String  @id @default(cuid())
  name      String
  role      String
  quote     String
  sortOrder Int     @default(0)
  published Boolean @default(true)
}

model ImpactStat {
  id        String @id @default(cuid())
  value     Int
  suffix    String @default("")
  label     String
  sortOrder Int    @default(0)
}

model CoreValue {
  id          String @id @default(cuid())
  title       String
  description String
  iconName    String
  sortOrder   Int    @default(0)
}

model TimelineEvent {
  id          String @id @default(cuid())
  year        String
  title       String
  description String
  sortOrder   Int    @default(0)
}

model TeamMember {
  id        String @id @default(cuid())
  name      String
  role      String
  bio       String
  imageUrl  String
  sortOrder Int    @default(0)
}

model DonationCause {
  id        String     @id @default(cuid())
  slug      String     @unique
  label     String
  sortOrder Int        @default(0)
  active    Boolean    @default(true)
  donations Donation[]
}

model Donation {
  id                    String         @id @default(cuid())
  reference             String         @unique
  amount                Int
  currency              String         @default("gbp")
  frequency             String
  status                String         @default("pending")
  donorName             String
  donorEmail            String
  donorPhone            String?
  donorAddress          String?
  message               String?
  anonymous             Boolean        @default(false)
  giftAid               Boolean        @default(false)
  stripeSessionId       String?        @unique
  stripePaymentIntentId String?
  causeId               String
  cause                 DonationCause  @relation(fields: [causeId], references: [id])
  projectId             String?
  project               Project?       @relation(fields: [projectId], references: [id])
  createdAt             DateTime       @default(now())
  completedAt           DateTime?
}

model ContactMessage {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  phone     String?
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
}
