# ─── Local development (SQLite) ───────────────────────────────────────────────
# DATABASE_URL="file:./dev.db"
# Leave DIRECT_DATABASE_URL unset for SQLite.

# ─── Production (PostgreSQL on Vercel) ────────────────────────────────────────
# Use the POOLED URL for the app — NOT the migration/direct URL.
#
# Vercel Postgres / Prisma Postgres integration:
#   DATABASE_URL          →  POSTGRES_PRISMA_URL        (pooled, for the app)
#   DIRECT_DATABASE_URL   →  POSTGRES_URL_NON_POOLING   (migrations/seed only)
#
# Neon:
#   DATABASE_URL          →  pooled URL (host contains "-pooler")
#   DIRECT_DATABASE_URL   →  direct URL (no pooler)
#   Add to pooled URL: ?pgbouncer=true&connection_limit=1
#
# Supabase:
#   DATABASE_URL          →  Transaction pooler URL (port 6543)
#   DIRECT_DATABASE_URL   →  Direct URL (port 5432)

DATABASE_URL="file:./dev.db"
# DIRECT_DATABASE_URL="postgresql://..."

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_LOAD_LOCAL_IMAGES="false"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
