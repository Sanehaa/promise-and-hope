# ─── Production (Vercel / PostgreSQL) ─────────────────────────────────────────
# App runtime — MUST be the pooled URL (never prisma_migration / direct URL):
#   DATABASE_URL  =  POSTGRES_PRISMA_URL  (Vercel) or pooler / transaction URL
#
# Migrations & seed only — direct connection:
#   DIRECT_URL    =  POSTGRES_URL_NON_POOLING  (Vercel) or direct URL (port 5432)

# Pooled (app) — host often pooled.db.prisma.io or *-pooler*
DATABASE_URL="postgresql://USER:PASS@pooled.db.prisma.io:5432/DB?sslmode=require"

# Direct (migrations only) — host db.prisma.io, NOT pooled
DIRECT_URL="postgresql://USER:PASS@db.prisma.io:5432/DB?sslmode=require"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3001"
NEXT_PUBLIC_LOAD_LOCAL_IMAGES="false"

# Zeffy donations (https://www.zeffy.com)
# Required unless you use embed only: full donation form link from Campaigns → Share
NEXT_PUBLIC_ZEFFY_DONATION_URL="https://www.zeffy.com/en-GB/donation-form/donate-to-change-lives-25427"
# Optional: iframe src from Campaigns → Share → Embed → Campaign (paste src= URL only)
# NEXT_PUBLIC_ZEFFY_EMBED_SRC="https://www.zeffy.com/embed/..."

# Contact form (Resend)
RESEND_API_KEY="re_..."
CONTACT_RECEIVER_EMAIL="promiseandhope@outlook.com"
